{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TV Series Tracker Official Data v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "series"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tmdbId", "title", "nextSeasonNumber", "status", "releaseDate", "releaseYear", "sourceName", "sourceUrl", "announcementDate", "lastChecked"],
        "properties": {
          "tmdbId": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "nextSeasonNumber": { "type": ["integer", "null"], "minimum": 1 },
          "status": { "enum": ["RENEWED", "RELEASE_DATE_CONFIRMED", "FINAL_SEASON", "CANCELED"], "description": "Season decision; FINAL_SEASON may also have a confirmed releaseDate." },
          "releaseDate": { "type": ["string", "null"], "format": "date", "description": "An independently verified premiere date, including for FINAL_SEASON." },
          "releaseYear": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
          "sourceName": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "announcementDate": { "type": ["string", "null"], "format": "date" },
          "lastChecked": { "type": "string", "format": "date" }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "RELEASE_DATE_CONFIRMED" } } },
            "then": { "properties": { "releaseDate": { "type": "string", "format": "date" } } } }
        ]
      }
    }
  }
}
